{
	"schemaVersion": 1,
	"id": "kiranzip",
	"version": "${version}",
	"name": "Snapshot",
	"description": "A camera mod for Minecraft.",
	"authors": [
		"kiranzip"
	],
	"contact": {
		"homepage": "https://kiran.zip/",
		"sources": "https://github.com/kiranzip/mc-camera"
	},
	"license": "GNU GPLv3",
	"icon": "assets/kiranzip/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"zip.kiran.snapshot.CameraMod"
		],
		"client": [
			"zip.kiran.snapshot.client.CameraModClient"
		]
	},
	"mixins": [
		{
			"config": "kiranzip.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}